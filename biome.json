{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!.build",
      "!.jj",
      "!.git",
      "!.vendor",
      "!.claude",
      "!.codex",
      "!.agents",
      "!fixtures",
      "!assets",
      "!.artifacts",
      "!.ci-inputs",
      "!.ci-fixtures",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.js",
      "!**/*.js.map",
      "!package-lock.json",
      "!THIRD_PARTY_NOTICES.md",
      "!showcase/fixtures",
      "!showcase/tests/boundary-fixtures",
      "!showcase/.work",
      "!showcase/site/.astro",
      "!showcase/site/.work",
      "!showcase/site/dist",
      "!showcase/site/node_modules",
      "!showcase/site/public/_formicarium",
      "!showcase/site/public/guests",
      "!showcase/site/public/catalog.json",
      "!showcase/site/public/demo-fixtures",
      "!showcase/site/public/coi-serviceworker.js",
      "!showcase/site/tooling/astro-check/node_modules"
    ]
  },
  "overrides": [
    {
      "includes": ["showcase/site/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["showcase/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/runtime/**",
                      "**/types/**",
                      "../../runtime/**",
                      "../../types/**",
                      "../../../runtime/**",
                      "../../../types/**"
                    ],
                    "message": "showcase は公開 export（@aletheia-works/formicarium、/node、/browser）だけを使う。本体の内部を import しない。"
                  },
                  {
                    "group": [
                      "@aletheia-works/formicarium/**",
                      "!@aletheia-works/formicarium/node",
                      "!@aletheia-works/formicarium/browser"
                    ],
                    "message": "package 内部の path ではなく公開 export を使う。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

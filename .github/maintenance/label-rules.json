{
  "schemaVersion": 1,
  "rules": [
    {
      "label": "ci",
      "paths": [".github"]
    },
    {
      "label": "dependencies",
      "paths": ["package.json", "bun.lock"]
    },
    {
      "label": "runtime",
      "paths": ["runtime", "index.ts"]
    },
    {
      "label": "tests",
      "paths": ["tests"]
    },
    {
      "label": "documentation",
      "paths": ["README.md", "docs"]
    },
    {
      "label": "tooling",
      "paths": ["scripts", "mise.toml"]
    }
  ]
}

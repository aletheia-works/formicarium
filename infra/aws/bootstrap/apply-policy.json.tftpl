{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::formicarium-*",
        "arn:aws:s3:::formicarium-*/*"
      ]
    },
    {
      "Sid": "WriteOwnFunctionsAndImages",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:*:${account_id}:function:formicarium-*",
        "arn:aws:lambda:*:${account_id}:microvm-image:formicarium-*"
      ]
    },
    {
      "Sid": "WriteOwnLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:*:${account_id}:log-group:/formicarium/*",
        "arn:aws:logs:*:${account_id}:log-group:/formicarium/*:*"
      ]
    },
    {
      "Sid": "CreateWorkloadRolesInsideTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/formicarium-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/formicarium-workload-boundary"
        }
      }
    },
    {
      "Sid": "ManageWorkloadRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/formicarium-*"
    },
    {
      "Sid": "PassWorkloadRolesToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/formicarium-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "KeepTheBoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "arn:aws:iam::${account_id}:role/formicarium-*"
    }
  ]
}

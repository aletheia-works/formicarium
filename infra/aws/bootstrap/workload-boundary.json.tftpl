{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::formicarium-*/*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:${account_id}:log-group:/formicarium/*",
        "arn:aws:logs:*:${account_id}:log-group:/formicarium/*:*"
      ]
    },
    {
      "Sid": "RunOwnMicrovms",
      "Effect": "Allow",
      "Action": [
        "lambda:RunMicrovm",
        "lambda:GetMicrovm",
        "lambda:SuspendMicrovm",
        "lambda:ResumeMicrovm",
        "lambda:TerminateMicrovm",
        "lambda:CreateMicrovmAuthToken",
        "lambda:GetMicrovmImage"
      ],
      "Resource": "arn:aws:lambda:*:${account_id}:microvm-image:formicarium-*"
    },
    {
      "Sid": "ListMicrovms",
      "Effect": "Allow",
      "Action": "lambda:ListMicrovms",
      "Resource": "*"
    }
  ]
}

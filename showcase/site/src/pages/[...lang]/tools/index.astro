---
// /tools/ loads no terminal module, formicarium or guest (BR4.3).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { requireStrings, stringsFor } from '../../../i18n/strings.ts';
import { loadSiteData } from '../../../site-data.ts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: 'en' as const } },
    { params: { lang: 'ja' }, props: { locale: 'ja' as const } },
  ];
}
const { locale } = Astro.props;
const site = loadSiteData();
requireStrings(site.tools.map((tool) => tool.tool));
const strings = stringsFor(locale);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = locale === 'ja' ? `${base}ja/` : base;
---

<StarlightPage
  frontmatter={{
    title: strings.tools.title,
    description: strings.tools.description,
    tableOfContents: false,
  }}
>
  <p>{strings.tools.intro}</p>
  <div class="tool-cards" data-testid="tool-cards">
    {
      site.tools.map((tool) => {
        const text = strings.tool[tool.tool as keyof typeof strings.tool];
        return (
          <ToolCard
            tool={tool.tool}
            href={`${prefix}tools/${tool.tool}/`}
            label={text.label}
            version={tool.version}
            summary={text.summary}
            open={strings.tools.open}
          />
        );
      })
    }
  </div>
  <p>
    <a href={`${prefix}terminal/`} data-testid="tools-empty-terminal"
      >{strings.tools.emptyLink}</a
    >
  </p>
</StarlightPage>

<style>
  .tool-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
</style>

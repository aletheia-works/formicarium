@@ -0,0 +1,41 @@
+import { afterEach, expect, test } from "bun:test";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { recordedSourceListingUnderCurrentBoundary, workspaceSourceState } from "../../core/tools/aidlc-lib.ts";
+const dirs: string[] = [];
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+test("jj and generated output churn does not alter source, real source still does", () => {
+  const dir = mkdtempSync(join(tmpdir(), "aidlc-formicarium-regression-")); dirs.push(dir);
+  writeFileSync(join(dir, "main.ts"), "export const n=1;\n");
+  const before = workspaceSourceState(dir)!.fingerprint;
+  for (const name of [".jj", ".artifacts", ".build"]) {
+    mkdirSync(join(dir, name)); writeFileSync(join(dir, name, "output"), "old");
+    expect(workspaceSourceState(dir)!.fingerprint).toBe(before);
+    writeFileSync(join(dir, name, "output"), "new");
+    expect(workspaceSourceState(dir)!.fingerprint).toBe(before);
+  }
+  writeFileSync(join(dir, "main.ts"), "export const n=2;\n");
+  expect(workspaceSourceState(dir)!.fingerprint).not.toBe(before);
+});
+test("old regular output listing migrates without hiding symlinks or current registered files", () => {
+  const old = new Map([["\0.jj/store/head", "100644 hash"], ["\0.artifacts/output", "100644 hash"], ["\0.build/output", "100644 hash"], ["\0.build/link", "120000 hash"], ["\0main.ts", "100644 hash"]]);
+  const current = new Map([["\0.artifacts/output", "100644 registered"], ["\0main.ts", "100644 hash"]]);
+  const kept = recordedSourceListingUnderCurrentBoundary(old, current);
+  expect([...kept.keys()]).toEqual(["\0.artifacts/output", "\0.build/link", "\0main.ts"]);
+});
+test("adjacent tsc outputs stay outside source; malformed maps and explicit registration remain bound", () => {
+  const dir = mkdtempSync(join(tmpdir(), "aidlc-ts-output-regression-")); dirs.push(dir);
+  writeFileSync(join(dir, "main.ts"), "export const n=1;\n");
+  const before = workspaceSourceState(dir)!.fingerprint;
+  writeFileSync(join(dir, "main.js"), "export const n=1;\n//# sourceMappingURL=main.js.map\n");
+  writeFileSync(join(dir, "main.js.map"), JSON.stringify({version:3,file:"main.js",sources:["main.ts"],mappings:""}));
+  expect(workspaceSourceState(dir)!.fingerprint).toBe(before);
+  writeFileSync(join(dir, "main.js.map"), "{}");
+  expect(workspaceSourceState(dir)!.fingerprint).not.toBe(before);
+  writeFileSync(join(dir, "main.js.map"), JSON.stringify({version:3,file:"main.js",sources:["main.ts"],mappings:""}));
+  writeFileSync(join(dir, ".aidlc-source-paths.json"), JSON.stringify({version:1,paths:["main.js"]}));
+  const registered = workspaceSourceState(dir)!.fingerprint;
+  writeFileSync(join(dir, "main.js"), "export const n=2;\n//# sourceMappingURL=main.js.map\n");
+  expect(workspaceSourceState(dir)!.fingerprint).not.toBe(registered);
+});
